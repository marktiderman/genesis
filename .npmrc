# Use hoisted node_modules layout for Metro bundler compatibility
# Required for Expo/React Native apps in pnpm workspaces
node-linker=hoisted

# Auto-install peer dependencies
auto-install-peers=true

# Relax peer dependency checks (RN packages often have conflicting peers)
strict-peer-dependencies=false

# Genesis publishes @genesis/* packages PUBLIC on npmjs.com (the default
# registry) — no per-consumer auth required. See docs/poc-plan.md and
# docs/research/publishing-setup.md for the pivot rationale (April 2026).
# Publishing uses NPM_TOKEN in CI; local dev needs no npm auth.
