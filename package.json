{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "description": "Genesis — a shadcn-based, brand-agnostic design system and data-provider layer for building React apps fast.",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "check:error-reporting": "node scripts/check-error-reporting.mjs",
    "check:forbidden-imports": "node scripts/check-forbidden-imports.mjs",
    "check:legacy-imports": "node scripts/check-legacy-imports.mjs",
    "check:navigation-reimplementation": "node scripts/check-navigation-reimplementation.mjs",
    "check:peer-deps": "node scripts/check-peer-deps.mjs",
    "check:industry-words": "node scripts/check-industry-words.mjs",
    "check:private-names": "node scripts/check-private-names.mjs",
    "check:testid-coverage": "node scripts/check-testid-coverage.mjs",
    "check:token-usage": "node scripts/check-token-usage.mjs",
    "clean:packages": "pnpm --filter \"@marktiderman/genesis-*\" clean",
    "coverage:design-system": "node scripts/design-system-coverage.mjs",
    "features": "genesis features",
    "features:build": "genesis features build",
    "features:check": "genesis features check",
    "gen:component-reference": "node scripts/gen-component-reference.mjs",
    "lint": "pnpm -r lint",
    "lint:genesis": "pnpm check:legacy-imports && pnpm check:token-usage && pnpm check:forbidden-imports && pnpm check:navigation-reimplementation && pnpm check:peer-deps && pnpm check:testid-coverage && pnpm check:error-reporting",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "vitest run --config vitest.scripts.config.mjs",
    "typecheck": "pnpm -r typecheck",
    "version:packages": "changeset version",
    "product": "genesis-product"
  },
  "devDependencies": {
    "@changesets/cli": "~2.30.0",
    "@marktiderman/genesis-cli": "workspace:*",
    "@marktiderman/genesis-features": "workspace:*",
    "@marktiderman/genesis-product": "workspace:*",
    "vitest": "^5.0.5",
    "yaml": "^2.6.0"
  },
  "genesisFeatures": {
    "registry": "features.ts",
    "command": "pnpm features",
    "marketing": "README.md",
    "coverage": [
      "packages/*/src/index.{ts,tsx}"
    ],
    "coverageIgnore": []
  }
}
