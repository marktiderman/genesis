{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x node_modules/.bin/genesis ] && node_modules/.bin/genesis features check --summary 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "genesis": {
      "source": {
        "source": "github",
        "repo": "marktiderman/genesis-plugin"
      }
    }
  },
  "enabledPlugins": {
    "genesis@genesis": true
  }
}
