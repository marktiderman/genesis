{
  "name": "sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "pnpm docs:generate",
    "build": "react-router build && tsx scripts/generate-site-files.ts",
    "typecheck": "react-router typegen && tsc",
    "docs:generate": "tsx scripts/generate-primitive-docs.ts",
    "docs:check": "tsx scripts/generate-primitive-docs.ts --check && tsx scripts/check-demo-coverage.ts",
    "coverage:check": "tsx scripts/check-demo-coverage.ts",
    "smoke": "node scripts/smoke-site.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --project storybook",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --build-script-name=build-storybook --exit-zero-on-changes",
    "studio:db": "node studio/setup-db.mjs",
    "studio:supabase": "cd studio/supabase-demo && supabase start && node seed.mjs",
    "studio:adopt": "node studio/supabase-demo/adopt.mjs",
    "dev:supabase": "react-router dev --mode supabase",
    "studio:contract": "genesis introspect --database-env STUDIO_CONTRACT_DATABASE_URL --out studio/resources.genesis.ts"
  },
  "dependencies": {
