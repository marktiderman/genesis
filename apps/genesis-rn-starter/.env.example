# Copy to .env (git-ignored) and fill in. Both values are public: they ship in the app bundle.
# Supabase dashboard -> Project Settings -> API (or `supabase status` for a local stack).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: Sentry crash and error reporting (features.observability). Sentry project -> Settings ->
# Client Keys (DSN). Public too: it only lets the app send events. Empty means no Sentry.
EXPO_PUBLIC_SENTRY_DSN=
