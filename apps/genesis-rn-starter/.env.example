# Copy to .env (git-ignored) and fill in. Both values are public: they ship in the app bundle.
# Supabase dashboard -> Project Settings -> API (or `supabase status` for a local stack).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
