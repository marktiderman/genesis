# Copy to .env (git-ignored) and fill in. Both values are public: they ship in the app bundle.
# Supabase dashboard -> Project Settings -> API (or `supabase status` for a local stack).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: Sentry crash and error reporting (features.observability). Sentry project -> Settings ->
# Client Keys (DSN). Public too: it only lets the app send events. Empty means no Sentry.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: native Google sign-in (features.googleSignIn, off by default). Google Cloud -> APIs &
# Services -> Credentials: the Web client id and the iOS client id. Public: they ship in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional: chat video messages through Mux. Your server's createVideoUploadHandler URL
# (@marktiderman/genesis-chat/server). Empty: videos go to Supabase Storage as files.
EXPO_PUBLIC_CHAT_VIDEO_UPLOAD_URL=
