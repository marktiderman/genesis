{
  "name": "@marktiderman/genesis-features",
  "version": "0.9.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "deprecated": "Renamed to @marktiderman/genesis-config. Run `npx genesis codemod genesis-features-renamed-genesis-config` to move your imports and dependency (genesis upgrade runs it too). This alias re-exports genesis-config for two minor versions (0.10 and 0.11), then goes.",
  "description": "Deprecated: renamed to @marktiderman/genesis-config. A thin re-export of genesis-config with the same subpaths, kept for two minor versions. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "deprecated"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/features-alias#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/features-alias"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./gate/react": {
      "types": "./dist/gate-react.d.ts",
      "import": "./dist/gate-react.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./settings/react": {
      "types": "./dist/settings-react.d.ts",
      "import": "./dist/settings-react.js"
    },
    "./settings-protocol": {
      "types": "./dist/settings-protocol.d.ts",
      "import": "./dist/settings-protocol.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-config": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "foundation",
    "group": "core",
    "owner": "@marktiderman",
    "doctor": {
      "enforce": false,
      "reason": "A deprecated alias that re-exports @marktiderman/genesis-config, whose declarations carry the rules."
    }
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui": "workspace:>=3.0.0 <4.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
