exports[`testimonials > renders the grid variant: snapshot, outline and axe 1`] = `"<section data-slot="band" data-surface="muted" class="relative w-full bg-muted text-foreground py-12 sm:py-16 lg:py-20" aria-labelledby="gs-testimonials-title" data-gs-section="testimonials" data-gs-variant="grid"><div data-slot="band-inner" class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8"><div class="flex max-w-3xl flex-col gap-4 mx-auto items-center text-center"><h2 data-slot="display" class="font-display font-bold tracking-tight text-balance text-3xl leading-tight sm:text-4xl" id="gs-testimonials-title">Members say</h2></div><ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-12"><li><figure class="flex h-full flex-col justify-between gap-6 rounded-xl border border-border bg-background p-6 text-foreground"><blockquote class="leading-relaxed"><p>“I never thought I&#x27;d enjoy training. Now I don&#x27;t miss a week.”</p></blockquote><figcaption class="flex items-center gap-3"><img src="/images/sam.jpg" alt="Sam Lee" width="1200" height="900" sizes="48px" loading="lazy" decoding="async" class="rounded-full object-cover size-11"/><span class="flex flex-col text-left"><span class="font-semibold">Sam Lee</span><span class="text-sm text-muted-foreground">Member since 2022</span></span></figcaption></figure></li><li><figure class="flex h-full flex-col justify-between gap-6 rounded-xl border border-border bg-background p-6 text-foreground"><blockquote class="leading-relaxed"><p>“The coaches actually remember my goals.”</p></blockquote><figcaption class="flex items-center gap-3"><span class="flex flex-col text-left"><span class="font-semibold">Jane Doe</span></span></figcaption></figure></li></ul></div></section>"`;

