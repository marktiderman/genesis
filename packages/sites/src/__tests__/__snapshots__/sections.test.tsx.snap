exports[`pricing > renders the cards variant: snapshot, outline and axe 1`] = `"<section data-slot="band" data-surface="base" class="relative w-full bg-background text-foreground py-12 sm:py-16 lg:py-20" aria-labelledby="gs-pricing-title" data-gs-section="pricing" data-gs-variant="cards"><div data-slot="band-inner" class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8"><div class="flex max-w-3xl flex-col gap-4 mx-auto items-center text-center"><h2 data-slot="display" class="font-display font-bold tracking-tight text-balance text-3xl leading-tight sm:text-4xl" id="gs-pricing-title">Memberships</h2><p data-slot="band-lead" class="text-lg leading-relaxed sm:text-xl text-pretty text-muted-foreground">No joining fee.</p></div><ul class="mt-12 grid gap-6 md:grid-cols-2 max-w-4xl mx-auto"><li class="flex flex-col gap-6 rounded-2xl border bg-background p-8 text-foreground border-border"><div class="flex flex-col gap-2"><div class="flex items-center justify-between gap-2"><h3 class="font-display text-lg font-semibold leading-snug">Two a week</h3></div></div><p><span class="font-display text-4xl font-bold">$89</span><span class="text-muted-foreground"> per month</span></p><ul class="flex flex-col gap-3"><li class="flex gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 size-5 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>Two classes a week</span></li><li class="flex gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 size-5 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span>Open gym</span></li></ul><a href="#contact" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-