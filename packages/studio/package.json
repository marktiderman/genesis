{
  "name": "@marktiderman/genesis-studio",
  "version": "0.4.3",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "deprecated": "Renamed to @marktiderman/genesis-data (Genesis Data Studio is now Genesis Data): change the imports and the dependency to the new name; the exports are the same. This alias re-exports genesis-data for two minor versions, then goes.",
  "description": "Deprecated: renamed to @marktiderman/genesis-data. A thin re-export of genesis-data with the same entries and stylesheets, kept for two minor versions. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "deprecated"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/studio#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/studio"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./standalone.css": "./dist/standalone.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-data": "workspace:^"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.1.0 || ^6.0.0 || ^7.0.0",
    "@marktiderman/genesis-core": "workspace:>=2.11.0 <3.0.0",
    "@marktiderman/genesis-ui": "workspace:>=2.36.0 <4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.14.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "primitive",
    "group": "data",
    "owner": "@marktiderman",
    "doctor": {
      "enforce": false,
      "reason": "A deprecated alias that re-exports @marktiderman/genesis-data, whose declarations carry the rules."
    }
  }
}
