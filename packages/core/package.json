{
  "name": "@marktiderman/genesis-core",
  "version": "2.2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Genesis platform-agnostic providers, hooks, and data layer. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "react",
    "data-layer",
    "providers",
    "hooks",
    "supabase"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces.d.ts",
      "import": "./dist/workspaces.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "import": "./dist/dates.js"
    },
    "./resource": {
      "types": "./dist/resource/index.d.ts",
      "import": "./dist/resource/index.js"
    },
    "./resource-view": {
      "types": "./dist/resource-view/index.d.ts",
      "import": "./dist/resource-view/index.js"
    },
    "./urls": {
      "types": "./dist/urls.d.ts",
      "import": "./dist/urls.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.4",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "genesis": {
    "doctor": {
      "prefer": [
        {
          "id": "direct-data-access",
          "need": "data access",
          "level": "warn",
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "exclude": [
            "src/lib/**",
            "**/*.server.*",
            "**/server/**",
            "**/api/**"
          ],
          "forbid": {
            "pattern": "(?:\\b[\\w$]*(?:supabase|Supabase|client|Client|db)[\\w$]*(?:\\(\\))?\\s*\\.\\s*(?:from|rpc)\\s*\\(|\\.schema\\s*\\([^)]*\\)\\s*\\.\\s*(?:from|rpc)\\s*\\(|\\.rpc\\s*\\()"
          },
          "use": "a view (defineView + ResourceView) for reads, the resource's provider writes (useWrite, ResourceForm) for writes, or a named data function in src/lib",
          "import": "@marktiderman/genesis-core",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md",
          "why": "A screen that queries the database hand-writes the data layer the provider and views already are, and its rules drift from the resource's. Server files and src/lib aren't checked; doctor.packageRules can widen or narrow that."
        }
      ],
      "primitives": [
        {
          "need": "dates and days",
          "use": "personDay(person), dayIn(zone), never toISOString().slice(0, 10)",
          "import": "@marktiderman/genesis-core/dates"
        },
        {
          "need": "a record's create or edit form",
          "use": "the view's form (ResourceForm), or useResourceForm",
          "import": "@marktiderman/genesis-core/hooks",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md"
        },
        {
          "need": "CSV export and import",
          "use": "the CSV helpers (paged through the provider, formula-safe)",
          "import": "@marktiderman/genesis-core/csv"
        },
        {
          "need": "write errors and refusals",
          "use": "DataWriteError and readFailureMessage",
          "import": "@marktiderman/genesis-core/errors"
        }
      ]
    }
  }
}
