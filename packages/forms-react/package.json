{
  "name": "@marktiderman/genesis-forms-react",
  "version": "0.3.2",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "React bindings for Genesis Forms: useForm, useField with one-field re-renders, a ranked renderer registry and a headless FormRuntime. Works in React DOM and React Native. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "forms",
    "react",
    "hooks"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/forms-react#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/forms-react"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs && tsc -p type-tests",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@marktiderman/genesis-forms": "workspace:>=0.7.0 <1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@marktiderman/genesis-forms": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "primitive",
    "group": "forms",
    "owner": "@marktiderman",
    "doctor": {
      "prefer": [
        {
          "id": "forms-use-genesis-forms",
          "need": "a form",
          "level": "warn",
          "forbid": {
            "imports": [
              "formik",
              "react-final-form",
              "final-form",
              "@tanstack/react-form"
            ],
            "pattern": "import\\s*\\{[^}]*\\buseForm\\b[^}]*\\}\\s*from\\s*[\"']react-hook-form[\"']"
          },
          "use": "the view's form (ResourceForm) for a record, or useForm / useField from Genesis Forms for a questionnaire",
          "import": "@marktiderman/genesis-forms-react",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/FORMS.md",
          "why": "Genesis forms carry validation, drafts and the server check; a second form library splits how forms behave."
        }
      ]
    }
  }
}
