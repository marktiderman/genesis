{
  "name": "@marktiderman/genesis-features",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "A typed feature registry: defineFeatures and defineFlags in one code file that running code imports, defineBlock and resolveBlocks for blocks (/blocks, free of zod), the feature gate (featureOn, /gate, zod-free, with React hooks at /gate/react), generators for AGENTS.md and JSON, a stale-output check, and a FeatureList page. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/features"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./gate/react": {
      "types": "./dist/gate-react.d.ts",
      "import": "./dist/gate-react.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui": "workspace:>=2.7.0 <3.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-ui": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.4.3"
  },
  "genesis": {
    "doctor": {
      "prefer": [
        {
          "id": "no-env-feature-switches",
          "need": "turning a feature on or off",
          "level": "warn",
          "forbid": {
            "pattern": "\\b(?:import\\.meta\\.env|process\\.env)\\.(?:VITE_|NEXT_PUBLIC_|EXPO_PUBLIC_)?(?:FEATURE|FF|ENABLE|FLAG)_[A-Z0-9_]+"
          },
          "use": "a feature in features.ts read with featureOn / useFeature, or a flag",
          "import": "@marktiderman/genesis-features",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/features/README.md",
          "why": "An environment switch needs a redeploy to change and isn't in the feature registry."
        }
      ]
    }
  }
}
