{
  "name": "@marktiderman/genesis-config",
  "version": "0.11.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Genesis configuration: the typed feature registry (defineFeatures, defineFlags), blocks (defineBlock, resolveBlocks; /blocks, free of zod), the feature gate (featureOn; /gate, zod-free, with React hooks at /gate/react), generators for AGENTS.md and JSON, a stale-output check, and a FeatureList page. Formerly @marktiderman/genesis-features. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "feature-flags",
    "feature-registry",
    "openfeature",
    "typescript",
    "configuration",
    "settings"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/features#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/features"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "blocks": [
        "./dist/blocks.d.cts"
      ],
      "gate": [
        "./dist/gate.d.cts"
      ],
      "gate/react": [
        "./dist/gate-react.d.ts"
      ],
      "settings": [
        "./dist/settings.d.cts"
      ],
      "settings/react": [
        "./dist/settings-react.d.ts"
      ],
      "settings-protocol": [
        "./dist/settings-protocol.d.cts"
      ],
      "setup": [
        "./dist/setup.d.cts"
      ],
      "node": [
        "./dist/node.d.cts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./blocks": {
      "import": {
        "types": "./dist/blocks.d.ts",
        "default": "./dist/blocks.js"
      },
      "require": {
        "types": "./dist/blocks.d.cts",
        "default": "./dist/blocks.cjs"
      }
    },
    "./gate": {
      "import": {
        "types": "./dist/gate.d.ts",
        "default": "./dist/gate.js"
      },
      "require": {
        "types": "./dist/gate.d.cts",
        "default": "./dist/gate.cjs"
      }
    },
    "./gate/react": {
      "types": "./dist/gate-react.d.ts",
      "import": "./dist/gate-react.js"
    },
    "./settings": {
      "import": {
        "types": "./dist/settings.d.ts",
        "default": "./dist/settings.js"
      },
      "require": {
        "types": "./dist/settings.d.cts",
        "default": "./dist/settings.cjs"
      }
    },
    "./settings/react": {
      "types": "./dist/settings-react.d.ts",
      "import": "./dist/settings-react.js"
    },
    "./settings-protocol": {
      "import": {
        "types": "./dist/settings-protocol.d.ts",
        "default": "./dist/settings-protocol.js"
      },
      "require": {
        "types": "./dist/settings-protocol.d.cts",
        "default": "./dist/settings-protocol.cjs"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      },
      "require": {
        "types": "./dist/setup.d.cts",
        "default": "./dist/setup.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui": "workspace:>=3.0.0 <4.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-ui": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.6"
  },
  "genesis": {
    "layer": "foundation",
    "group": "core",
    "owner": "@marktiderman",
    "essential": true,
    "doctor": {
      "prefer": [
        {
          "id": "no-env-feature-switches",
          "need": "turning a feature on or off",
          "level": "warn",
          "forbid": {
            "pattern": "\\b(?:import\\.meta\\.env|process\\.env)\\.(?:VITE_|NEXT_PUBLIC_|EXPO_PUBLIC_)?(?:FEATURE|FF|ENABLE|FLAG)_[A-Z0-9_]+"
          },
          "use": "a feature in features.ts read with featureOn / useFeature, or a flag",
          "import": "@marktiderman/genesis-config",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/features/README.md",
          "why": "An environment switch needs a redeploy to change and isn't in the feature registry."
        }
      ]
    }
  }
}
