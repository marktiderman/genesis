{
  "name": "@marktiderman/genesis-switchboard",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "The Switchboard — pluggable, cross-runtime data-layer config for Genesis. Composes LEVELS (L1 Code / L2 Middle / L3 Production) × TIERS (A env / B resource / C field) so the app reads one canonical shape and never knows where data lives. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/data-switchboard"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gitdata": {
      "types": "./dist/gitdata.d.ts",
      "import": "./dist/gitdata.js",
      "require": "./dist/gitdata.cjs"
    },
    "./data-provider": {
      "types": "./dist/data-provider.d.ts",
      "import": "./dist/data-provider.js",
      "require": "./dist/data-provider.cjs"
    }
  },
  "files": [
    "dist",
    "src/switchboard.config.sample.ts",
    "README.md",
    "SWITCHBOARD.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@supabase/supabase-js": ">=2.81.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-core": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@supabase/supabase-js": "^2.101.1",
    "@types/node": "^22",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
