{
  "name": "@marktiderman/genesis-cli",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "Genesis CLI — `genesis init` scaffolds a Genesis app; `genesis studio init` turns the Data Studio on in an existing app; `genesis introspect` writes a checked-in contract.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/genesis-cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "genesis": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scaffolder": {
      "types": "./dist/scaffolder.d.ts",
      "import": "./dist/scaffolder.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-studio-server": "workspace:^",
    "commander": "^12.1.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
