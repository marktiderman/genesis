{
  "name": "@marktiderman/genesis-cli",
  "version": "1.16.1",
  "private": false,
  "type": "module",
  "description": "Genesis CLI — `genesis init` scaffolds a Genesis app (`--template native`: a new Expo app from the RN starter); `genesis add <block>` adds a block from what its package declares; `genesis migrate` copies new package migrations in and never rewrites an applied one; `genesis upgrade` moves every Genesis package to one release and refreshes the files Genesis owns; `genesis doctor` checks an app against the installed Genesis; `genesis studio init` turns the Data Studio on; `genesis introspect` writes a checked-in contract; `genesis features build|check` keeps generated feature docs in step with features.ts; `withGenesis()` (`app.plugin.js`, `/expo`) is the Expo config plugin.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "cli",
    "scaffolding",
    "codemods",
    "linter",
    "doctor"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/genesis-cli#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/genesis-cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "genesis": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scaffolder": {
      "types": "./dist/scaffolder.d.ts",
      "import": "./dist/scaffolder.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "default": "./dist/expo.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-features": "workspace:^",
    "@marktiderman/genesis-studio-server": "workspace:^",
    "commander": "^15.0.0",
    "jiti": "^2.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@expo/config": "^55.0.19",
    "@expo/config-plugins": "^55.0.11",
    "@expo/config-types": "^55.0.6",
    "@marktiderman/genesis-core": "workspace:^",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=54",
    "@expo/config-types": ">=54",
    "@marktiderman/genesis-core": "^1.6.0 || ^2.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@expo/config-types": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "genesis": {
    "layer": "tooling",
    "group": "core",
    "owner": "@marktiderman",
    "doctor": {
      "enforce": false,
      "reason": "The doctor itself: its rules are the built-ins."
    }
  }
}
