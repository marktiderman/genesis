{
  "name": "@marktiderman/genesis-cli",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "description": "Genesis CLI — `genesis init` scaffolds a Genesis app; `genesis doctor` checks an app against the installed Genesis; `genesis studio init` turns the Data Studio on in an existing app; `genesis introspect` writes a checked-in contract; `genesis features build|check` keeps generated feature docs in step with features.ts; `withGenesis()` (`app.plugin.js`, `/expo`) is the Expo config plugin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/genesis-cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "genesis": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scaffolder": {
      "types": "./dist/scaffolder.d.ts",
      "import": "./dist/scaffolder.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js",
      "default": "./dist/expo.js"
    },
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-features": "workspace:^",
    "@marktiderman/genesis-studio-server": "workspace:^",
    "commander": "^12.1.0",
    "jiti": "^2.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@expo/config": "^55.0.19",
    "@expo/config-plugins": "^55.0.11",
    "@expo/config-types": "^55.0.6",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=54",
    "@expo/config-types": ">=54",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@expo/config-types": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
