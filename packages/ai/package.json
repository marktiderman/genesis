{
  "name": "@marktiderman/genesis-ai",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "One server-side pipeline for every AI call a Genesis app makes: consent, the feature gate, a bounded budget, server-side loading with a context manifest, safety routing, guardrails, the model call with rollouts, refusal and outage fallbacks, a usage row with no content and a trace. Tasks are versioned prompts with typed arguments and outputs, called by id; processors such as moderation and transcription are wrapped in place. Vendors are adapters (Anthropic and OpenAI ship), keys can be the platform's or a tenant's or person's own (BYOK, in Supabase Vault), and model records carry prices and capabilities that fail loudly on an unknown model. On the Vercel AI SDK, server only except /react. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/ai"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "react": "^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/openai": "4.0.99",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "ai": "7.0.148",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  },
  "genesis": {
    "blocks": {
      "ai-providers": {
        "feature": {
          "name": "AI core",
          "summary": "One server-side pipeline for every AI call: consent, the feature gate, a bounded budget, server-side loading, safety routing, guardrails, the model call, a usage row and a trace.",
          "keywords": [
            "ai",
            "llm",
            "genesis-ai",
            "usage",
            "ai budget",
            "consent"
          ],
          "audience": [
            "developer"
          ]
        },
        "platforms": [
          "server"
        ],
        "migrations": [
          {
            "file": "migrations/0001_genesis_ai.sql",
            "test": "migrations/tests/0001_genesis_ai.test.sql"
          }
        ]
      }
    },
    "doctor": {
      "prefer": [
        {
          "id": "ai-server-on-server",
          "need": "running an AI task or reaching a model vendor",
          "level": "warn",
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "exclude": [
            "**/*.server.*",
            "**/server/**",
            "**/api/**"
          ],
          "forbid": {
            "imports": [
              "@marktiderman/genesis-ai/server",
              "@marktiderman/genesis-ai/anthropic",
              "@marktiderman/genesis-ai/openai",
              "@marktiderman/genesis-ai/supabase"
            ]
          },
          "unless": {
            "pattern": "\\bcreateServerFn\\s*\\(|\\bexport\\s+(?:let|const|async\\s+function|function)\\s+(?:loader|action)\\b|\\bexport\\s*\\{[^}]*\\b(?:loader|action)\\b|^\\s*[\"']use server[\"']"
          },
          "use": "useAiTask or useAiStream in the browser, calling tasks by id through createAiHandler",
          "import": "@marktiderman/genesis-ai/react",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ai/README.md",
          "why": "The pipeline holds keys, prompts and the budget: in a browser bundle it leaks the first two and enforces nothing."
        },
        {
          "id": "ai-calls-through-genesis-ai",
          "need": "calling a language model",
          "level": "warn",
          "forbid": {
            "imports": [
              "ai",
              "@ai-sdk/*",
              "@anthropic-ai/sdk",
              "openai"
            ]
          },
          "use": "a task (defineTask) run through the genesis-ai pipeline",
          "import": "@marktiderman/genesis-ai",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ai/README.md",
          "why": "A direct SDK call skips consent, the feature gate, the budget, safety routing and the usage record."
        }
      ],
      "primitives": [
        {
          "need": "an AI feature: a summary, a draft, structured extraction or a reply",
          "use": "a task (defineTask) with a loader, a prompt and an output, served by createAiHandler and called with useAiTask",
          "import": "@marktiderman/genesis-ai",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ai/README.md"
        }
      ]
    }
  }
}
