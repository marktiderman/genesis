{
  "scenarioVersion": 1,
  "name": "contact-details: anonymous form skips identifying fields",
  "description": "With settings.anonymous true, identifying fields are off the path and not required; the server drops client-sent values for them and lists them in ignored.",
  "tags": [
    "contact-details",
    "identifying",
    "anonymous",
    "server",
    "security"
  ],
  "definition": {
    "schemaVersion": 1,
    "id": "contact-details-anonymous",
    "title": "Tell us about your visit",
    "blocks": [
      {
        "kind": "field",
        "id": "overall",
        "key": "overall",
        "type": "rating",
        "label": "How was your visit?",
        "required": true,
        "props": {
          "max": 5
        }
      },
      {
        "kind": "field",
        "id": "name",
        "key": "name",
        "type": "short-text",
        "label": "Your name",
        "required": true,
        "identifying": true
      },
      {
        "kind": "field",
        "id": "email",
        "key": "email",
        "type": "email",
        "label": "Email",
        "required": true,
        "identifying": true
      },
      {
        "kind": "field",
        "id": "phone",
        "key": "phone",
        "type": "phone",
        "label": "Phone",
        "identifying": true
      },
      {
        "kind": "field",
        "id": "comments",
        "key": "comments",
        "type": "long-text",
        "label": "Anything else?"
      }
    ],
    "endings": [
      {
        "id": "default",
        "title": "Thanks!"
      }
    ],
    "settings": {
      "anonymous": true
    }
  },
  "events": [
    {
      "type": "answer",
      "field": "overall",
      "value": 5
    },
    {
      "type": "answer",
      "field": "name",
      "value": "Ada"
    },
    {
      "type": "answer",
      "field": "email",
      "value": "ada@example.com"
    },
    {
      "type": "answer",
      "field": "phone",
      "value": "+1 555 010 0199"
    },
    {
      "type": "submit"
    }
  ],
  "expect": {
    "path": [
      "overall",
      "comments"
    ],
    "visible": [
      "overall",
      "comments"
    ],
    "current": "overall",
    "status": "completed",
    "ending": "default",
    "answers": {
      "overall": 5
    },
    "server": {
      "ok": true,
      "answers": {
        "overall": 5
      },
      "context": {},
      "ignored": [
        "name",
        "email",
        "phone"
      ]
    }
  }
}
