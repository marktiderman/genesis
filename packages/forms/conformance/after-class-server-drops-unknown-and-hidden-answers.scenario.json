{
  "scenarioVersion": 1,
  "name": "after-class: server drops unknown and hidden answers",
  "description": "The server replays the log: unknown fields are ignored, and answers to fields jumped over or hidden by logic are not stored.",
  "tags": [
    "after-class",
    "server",
    "security"
  ],
  "definition": {
    "schemaVersion": 1,
    "id": "after-class",
    "title": "How was class?",
    "blocks": [
      {
        "kind": "field",
        "id": "overall",
        "key": "overall",
        "type": "rating",
        "label": "How was today's class?",
        "required": true,
        "props": {
          "max": 5
        }
      },
      {
        "kind": "field",
        "id": "went_well",
        "key": "went_well",
        "type": "multi-choice",
        "label": "What went well?",
        "props": {
          "options": [
            {
              "value": "coaching",
              "label": "Coaching"
            },
            {
              "value": "workout",
              "label": "The workout"
            },
            {
              "value": "community",
              "label": "Community"
            },
            {
              "value": "scaling",
              "label": "Scaling options"
            },
            {
              "value": "equipment",
              "label": "Equipment"
            },
            {
              "value": "cleanliness",
              "label": "Cleanliness"
            }
          ]
        }
      },
      {
        "kind": "field",
        "id": "improve",
        "key": "improve",
        "type": "long-text",
        "label": "Anything we could do better?"
      },
      {
        "kind": "field",
        "id": "contact_me",
        "key": "contact_me",
        "type": "yes-no",
        "label": "Want {{hidden:coach|a coach}} to follow up with you?"
      },
      {
        "kind": "field",
        "id": "name",
        "key": "name",
        "type": "short-text",
        "label": "Your name",
        "required": true
      },
      {
        "kind": "field",
        "id": "email",
        "key": "email",
        "type": "email",
        "label": "Best email to reach you",
        "required": true
      }
    ],
    "layout": {
      "mode": "focus"
    },
    "hidden": [
      {
        "name": "class",
        "type": "string",
        "source": "server"
      },
      {
        "name": "coach",
        "type": "string",
        "source": "server"
      }
    ],
    "logic": [
      {
        "id": "r1",
        "when": {
          "op": "neq",
          "left": {
            "field": "contact_me"
          },
          "right": {
            "value": true
          }
        },
        "effect": "hide",
        "target": "name"
      },
      {
        "id": "r2",
        "when": {
          "op": "neq",
          "left": {
            "field": "contact_me"
          },
          "right": {
            "value": true
          }
        },
        "effect": "hide",
        "target": "email"
      },
      {
        "id": "r3",
        "when": {
          "op": "lt",
          "left": {
            "field": "overall"
          },
          "right": {
            "value": 4
          }
        },
        "effect": "jump",
        "from": "overall",
        "to": "improve"
      }
    ],
    "endings": [
      {
        "id": "default",
        "title": "Thanks! See you at the next class."
      }
    ],
    "settings": {
      "anonymous": true
    }
  },
  "context": {
    "class": "6:00 AM CrossFit",
    "coach": "Sam"
  },
  "events": [
    {
      "type": "answer",
      "field": "overall",
      "value": 5
    },
    {
      "type": "answer",
      "field": "went_well",
      "value": [
        "workout"
      ]
    },
    {
      "type": "answer",
      "field": "bogus",
      "value": "drop me"
    },
    {
      "type": "answer",
      "field": "name",
      "value": "Not asked"
    },
    {
      "type": "answer",
      "field": "overall",
      "value": 3
    },
    {
      "type": "answer",
      "field": "contact_me",
      "value": false
    },
    {
      "type": "submit"
    }
  ],
  "expect": {
    "path": [
      "overall",
      "improve",
      "contact_me"
    ],
    "visible": [
      "overall",
      "improve",
      "contact_me"
    ],
    "current": "overall",
    "status": "completed",
    "ending": "default",
    "answers": {
      "overall": 3,
      "contact_me": false
    },
    "server": {
      "ok": true,
      "answers": {
        "overall": 3,
        "contact_me": false
      },
      "context": {
        "class": "6:00 AM CrossFit",
        "coach": "Sam"
      },
      "ignored": [
        "bogus"
      ]
    }
  }
}
