{
  "scenarioVersion": 1,
  "name": "monthly-check-in: default ending",
  "description": "NPS 8 is one under the jump's boundary: every question is asked and the default ending is reached.",
  "tags": [
    "monthly-check-in",
    "ending"
  ],
  "definition": {
    "schemaVersion": 1,
    "id": "monthly-check-in",
    "title": "Monthly check-in",
    "blocks": [
      {
        "kind": "field",
        "id": "recommend",
        "key": "recommend",
        "type": "nps",
        "label": "How likely are you to recommend us to a friend?",
        "required": true
      },
      {
        "kind": "field",
        "id": "why",
        "key": "why",
        "type": "long-text",
        "label": "What's the main reason for your score?"
      },
      {
        "kind": "field",
        "id": "frequency",
        "key": "frequency",
        "type": "single-choice",
        "label": "How often did you use the service this month?",
        "props": {
          "options": [
            {
              "value": "1-4",
              "label": "1–4 times"
            },
            {
              "value": "5-8",
              "label": "5–8 times"
            },
            {
              "value": "9-12",
              "label": "9–12 times"
            },
            {
              "value": "13+",
              "label": "13 or more"
            }
          ]
        }
      }
    ],
    "layout": {
      "mode": "focus"
    },
    "logic": [
      {
        "id": "r1",
        "when": {
          "op": "gte",
          "left": {
            "field": "recommend"
          },
          "right": {
            "value": 9
          }
        },
        "effect": "jump",
        "from": "recommend",
        "to": {
          "ending": "promoter"
        }
      }
    ],
    "endings": [
      {
        "id": "default",
        "title": "Thanks for the honest feedback."
      },
      {
        "id": "promoter",
        "title": "Thank you! Tell a friend about us anytime."
      }
    ],
    "settings": {
      "anonymous": true
    }
  },
  "events": [
    {
      "type": "answer",
      "field": "recommend",
      "value": 8
    },
    {
      "type": "next"
    },
    {
      "type": "answer",
      "field": "why",
      "value": "Busy month"
    },
    {
      "type": "next"
    },
    {
      "type": "answer",
      "field": "frequency",
      "value": "5-8"
    },
    {
      "type": "submit"
    }
  ],
  "expect": {
    "path": [
      "recommend",
      "why",
      "frequency"
    ],
    "visible": [
      "recommend",
      "why",
      "frequency"
    ],
    "current": "frequency",
    "status": "completed",
    "ending": "default",
    "answers": {
      "recommend": 8,
      "why": "Busy month",
      "frequency": "5-8"
    },
    "server": {
      "ok": true,
      "answers": {
        "recommend": 8,
        "why": "Busy month",
        "frequency": "5-8"
      },
      "context": {}
    }
  }
}
