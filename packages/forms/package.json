{
  "name": "@marktiderman/genesis-forms",
  "version": "0.9.2",
  "private": false,
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/server.js",
    "./dist/server.cjs",
    "./dist/testing.js",
    "./dist/testing.cjs",
    "./dist/destinations.js",
    "./dist/destinations.cjs"
  ],
  "description": "Genesis Forms engine: a serializable form definition, logic, navigation, validation and server-side checking. Zero dependencies; runs in browsers, React Native, Node and edge runtimes. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/forms"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./destinations": {
      "import": {
        "types": "./dist/destinations.d.ts",
        "default": "./dist/destinations.js"
      },
      "require": {
        "types": "./dist/destinations.d.cts",
        "default": "./dist/destinations.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./conformance/*": "./conformance/*"
  },
  "files": [
    "dist",
    "conformance",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs && tsc -p type-tests",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance:build": "vite-node scripts/build-conformance.ts"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.2.4",
    "@marktiderman/genesis-connect": "workspace:^",
    "@marktiderman/genesis-supabase": "workspace:^",
    "fast-check": "^4.10.2",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
