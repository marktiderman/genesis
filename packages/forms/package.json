{
  "name": "@marktiderman/genesis-forms",
  "version": "0.10.1",
  "private": false,
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/server.js",
    "./dist/server.cjs",
    "./dist/testing.js",
    "./dist/testing.cjs",
    "./dist/destinations.js",
    "./dist/destinations.cjs"
  ],
  "description": "Genesis Forms engine: a serializable form definition, logic, navigation, validation and server-side checking. Zero dependencies; runs in browsers, React Native, Node and edge runtimes. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "forms",
    "form-engine",
    "surveys",
    "validation",
    "typescript"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/forms"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./destinations": {
      "import": {
        "types": "./dist/destinations.d.ts",
        "default": "./dist/destinations.js"
      },
      "require": {
        "types": "./dist/destinations.d.cts",
        "default": "./dist/destinations.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./conformance/*": "./conformance/*"
  },
  "files": [
    "dist",
    "conformance",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs && tsc -p type-tests",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance:build": "vite-node scripts/build-conformance.ts"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@marktiderman/genesis-connect": "workspace:^",
    "@marktiderman/genesis-supabase": "workspace:^",
    "fast-check": "^4.10.2",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "primitive",
    "group": "forms",
    "doctor": {
      "prefer": [
        {
          "id": "server-check-on-server",
          "need": "checking a form submission",
          "level": "warn",
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "exclude": [
            "**/*.server.*",
            "**/server/**",
            "**/api/**"
          ],
          "forbid": {
            "imports": [
              "@marktiderman/genesis-forms/server"
            ]
          },
          "unless": {
            "pattern": "\\bcreateServerFn\\s*\\(|\\bexport\\s+(?:let|const|async\\s+function|function)\\s+(?:loader|action)\\b|\\bexport\\s*\\{[^}]*\\b(?:loader|action)\\b|^\\s*[\"']use server[\"']"
          },
          "use": "the server check in a server function or API route",
          "import": "@marktiderman/genesis-forms/server",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/FORMS.md",
          "why": "The server check is the trust boundary: in a browser bundle it protects nothing."
        }
      ],
      "primitives": [
        {
          "need": "a questionnaire, survey or multi-step form",
          "use": "a Genesis Forms definition (defineForm) with its logic and validation",
          "import": "@marktiderman/genesis-forms",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/FORMS.md"
        }
      ]
    }
  }
}
