{
  "name": "@marktiderman/genesis-ui-native",
  "version": "3.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Genesis React Native components (NativeWind v4-5). Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/ui-native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "react-native": "./src/components/index.ts",
      "import": "./dist/components/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "react-native": "./src/data/index.ts",
      "import": "./dist/data/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "react-native": "./src/hooks/index.ts",
      "import": "./dist/hooks/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "react-native": "./src/layouts/index.ts",
      "import": "./dist/layouts/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "react-native": "./src/utils.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/lucide.d.ts",
      "react-native": "./src/icons/lucide.ts",
      "import": "./dist/icons/lucide.js",
      "default": "./dist/icons/lucide.js"
    }
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0",
    "@hookform/resolvers": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@react-native-community/datetimepicker": ">=8.0.0",
    "@shopify/flash-list": ">=2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.0.0",
    "expo-glass-effect": ">=0.1.0",
    "expo-haptics": ">=14.0.0",
    "expo-image": ">=2.0.0",
    "expo-symbols": ">=0.4.0",
    "lucide-react-native": ">=0.475.0",
    "nativewind": "^4.0.0 || ^5.0.0-preview",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-native": ">=0.76.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-keyboard-controller": ">=1.11.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "@expo/ui": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-symbols": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "genesis": {
    "doctor": {
      "prefer": [
        {
          "id": "lists-use-native-resource-view",
          "need": "a list screen on the phone",
          "level": "warn",
          "platform": "native",
          "newOnly": true,
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "forbid": {
            "jsx": [
              "FlatList",
              "SectionList",
              "NativeResourcePage"
            ]
          },
          "unless": {
            "renders": [
              "NativeResourceView",
              "NativeResourceWorkspace"
            ]
          },
          "use": "the web screen's view (defineView) rendered by <NativeResourceView>",
          "import": "@marktiderman/genesis-ui-native/data",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md#native",
          "why": "The phone list comes from the same view as the web list: one description, two surfaces, no second set of helpers."
        }
      ],
      "primitives": [
        {
          "need": "a phone screen",
          "use": "ScreenContainer, or a …Page / …Screen layout",
          "import": "@marktiderman/genesis-ui-native/layouts",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a record page on the phone",
          "use": "NativeResourceWorkspace",
          "import": "@marktiderman/genesis-ui-native/data",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md#resourceworkspace"
        }
      ]
    }
  }
}
