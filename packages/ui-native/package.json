{
  "name": "@marktiderman/genesis-ui-native",
  "version": "3.7.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Genesis React Native components (NativeWind v4-5). Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "react-native",
    "ui",
    "components",
    "nativewind",
    "expo"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/ui-native#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/ui-native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "react-native": "./src/components/index.ts",
      "import": "./dist/components/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "react-native": "./src/data/index.ts",
      "import": "./dist/data/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "react-native": "./src/hooks/index.ts",
      "import": "./dist/hooks/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "react-native": "./src/layouts/index.ts",
      "import": "./dist/layouts/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "react-native": "./src/utils.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./icons/lucide": {
      "types": "./dist/icons/lucide.d.ts",
      "react-native": "./src/icons/lucide.ts",
      "import": "./dist/icons/lucide.js",
      "default": "./dist/icons/lucide.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0",
    "@hookform/resolvers": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.0.0",
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@react-native-community/datetimepicker": ">=8.0.0",
    "@shopify/flash-list": ">=2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.0.0",
    "expo-glass-effect": ">=0.1.0",
    "expo-haptics": ">=14.0.0",
    "expo-image": ">=2.0.0",
    "expo-symbols": ">=0.4.0",
    "lucide-react-native": ">=0.475.0",
    "nativewind": "^4.0.0 || ^5.0.0-preview",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-native": ">=0.76.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-keyboard-controller": ">=1.21.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "@react-native-community/datetimepicker": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "@expo/ui": {
      "optional": true
    },
    "@shopify/flash-list": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-symbols": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "foundation",
    "group": "core",
    "owner": "@marktiderman",
    "essential": true,
    "doctor": {
      "prefer": [
        {
          "id": "lists-use-native-resource-view",
          "need": "a list screen on the phone",
          "level": "warn",
          "platform": "native",
          "newOnly": true,
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "forbid": {
            "jsx": [
              "FlatList",
              "SectionList",
              "NativeResourcePage"
            ]
          },
          "unless": {
            "renders": [
              "NativeResourceView",
              "NativeRecordView",
              "NativeResourceWorkspace"
            ]
          },
          "use": "the web screen's view (defineView) rendered by <NativeResourceView>",
          "import": "@marktiderman/genesis-ui-native/data",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md#native",
          "why": "The phone list comes from the same view as the web list: one description, two surfaces, no second set of helpers."
        },
        {
          "id": "motion-uses-tokens",
          "need": "an animation on the phone",
          "level": "warn",
          "platform": "native",
          "newOnly": true,
          "files": [
            "**/*.tsx",
            "**/*.ts"
          ],
          "forbid": {
            "pattern": "(?:\\bwith(?:Timing|Spring)\\(\\s*[^,()]+,\\s*\\{[^}]*\\b(?:duration|damping|stiffness)\\s*:\\s*(?:0?\\.\\d*[1-9]|[1-9])|\\bAnimated\\.(?:timing|spring)\\(\\s*[^,()]+,\\s*\\{[^}]*\\b(?:duration|bounciness|speed|damping|stiffness)\\s*:\\s*(?:0?\\.\\d*[1-9]|[1-9])|\\b(?:FadeIn|FadeOut|Slide|Zoom|Bounce|Flip|Stretch|Roll|Rotate|Pinwheel|LightSpeed|Layout|LinearTransition|SequencedTransition|FadingTransition|JumpingTransition|CurvedTransition|EntryExitTransition)\\w*(?:\\.\\w+\\([^()]*\\))*\\.(?:duration|damping|stiffness)\\(\\s*(?:0?\\.\\d*[1-9]|[1-9]))"
          },
          "use": "useMotion() with animateMotion on the JS thread, or motionSpring / motionTiming inside a worklet: the shared motion tokens",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md#motion",
          "why": "Motion is defined once, and Reduce Motion is honoured in one place; a duration or spring written as a number drifts from the rest of the app."
        },
        {
          "id": "haptics-use-genesis",
          "need": "a haptic on the phone",
          "level": "warn",
          "platform": "native",
          "newOnly": true,
          "files": [
            "**/*.tsx",
            "**/*.ts"
          ],
          "exclude": [
            "**/__tests__/**",
            "**/*.test.ts",
            "**/*.test.tsx"
          ],
          "forbid": {
            "pattern": "(?:\\bimport\\s*\\*\\s*as\\s+(\\w+)\\s+from\\s*[\"']expo-haptics[\"'][\\s\\S]*?\\b\\1\\??\\.(?:impactAsync|selectionAsync|notificationAsync)\\(|\\bHaptics\\??\\.(?:impactAsync|selectionAsync|notificationAsync)\\(|\\bimport\\s*\\{[^}]*\\b(?:impactAsync|selectionAsync|notificationAsync)\\b[^}]*\\}\\s*from\\s*[\"']expo-haptics[\"'])"
          },
          "use": "useHaptics() (or a NativeButton's `haptic`, usePressFeedback for a pressable of your own), with expo-haptics passed once as GenesisModules.haptics",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md#haptics-and-press-feedback",
          "why": "Haptics are named once (light, select, success…) and go through one module that never throws; a direct expo-haptics call picks its own styles and breaks where the module isn't installed."
        },
        {
          "id": "threads-use-thread-list",
          "need": "a conversation's message list on the phone",
          "level": "warn",
          "platform": "native",
          "newOnly": true,
          "files": [
            "**/*.tsx",
            "**/*.jsx"
          ],
          "forbid": {
            "pattern": "(?:<(?:FlatList|FlashList)\\b[\\s\\S]{0,400}?\\binverted\\b(?!\\s*=\\s*\\{\\s*false\\s*\\})|\\bstartRenderingFromBottom\\s*:\\s*true)"
          },
          "unless": {
            "renders": [
              "ThreadPage",
              "NativeThreadList",
              "ChatThreadScreen"
            ]
          },
          "use": "ThreadPage, or NativeThreadList for a thread of your own (bottom-anchored, holds its place on load, jumps to a message)",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md#inbox-and-thread-inboxpage-and-threadpage",
          "why": "A hand-built inverted or bottom-started list recreates what NativeThreadList already does (G5), usually without holding its place, VoiceOver order or the jump."
        }
      ],
      "primitives": [
        {
          "need": "a phone screen",
          "use": "ScreenContainer, or a …Page / …Screen layout",
          "import": "@marktiderman/genesis-ui-native/layouts",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a record view on the phone",
          "use": "NativeRecordView",
          "import": "@marktiderman/genesis-ui-native/data",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md#recordview"
        },
        {
          "need": "a conversation on the phone: messages, a composer",
          "use": "ThreadPage (slots, modes, events), or NativeThreadList and NativeComposerBar to build your own",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md#inbox-and-thread-inboxpage-and-threadpage"
        },
        {
          "need": "a photo gallery on the phone",
          "use": "NativeGalleryGrid, with NativeGalleryCard for media-first cards",
          "import": "@marktiderman/genesis-ui-native/components",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a full-screen photo viewer on the phone (zoom, swipe down to close)",
          "use": "NativeLightbox",
          "import": "@marktiderman/genesis-ui-native/components",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a row's actions behind a swipe on the phone",
          "use": "NativeSwipeRow, on GenesisModules.swipeable",
          "import": "@marktiderman/genesis-ui-native/components",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "what a long press opens on the phone: a short list of actions",
          "use": "NativeContextMenu",
          "import": "@marktiderman/genesis-ui-native/components",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a star rating on the phone",
          "use": "NativeRating",
          "import": "@marktiderman/genesis-ui-native/components",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/ui-native/README.md"
        },
        {
          "need": "a photo gallery over a list (a photo per record, in justified rows)",
          "use": "the view's gallery block (defineView) rendered by <NativeResourceView mode=\"grid\">; NativeGalleryGrid for photos that aren't records (attachments, uploads)",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/RESOURCE-VIEW.md#gallery"
        },
        {
          "need": "a bottom tab bar with any number of tabs",
          "use": "NativeTabBar (past max, the last slot is More, which opens a NativeSheet)",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/DESIGN-LIBRARY.md"
        },
        {
          "need": "actions on the rows a list has selected",
          "use": "NativeBulkBar",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/DESIGN-LIBRARY.md"
        },
        {
          "need": "sharing a published page's link, with a QR code",
          "use": "NativeShareSheet with url, renderQr and onCopy",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/DESIGN-LIBRARY.md"
        },
        {
          "need": "a what's new sheet after an update",
          "use": "NativeWhatsNewSheet",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/DESIGN-LIBRARY.md"
        },
        {
          "need": "a rank or tier label (Gold, Level 3) in a brand accent",
          "use": "NativeTierBadge with tone set to a key of the brand's accents",
          "import": "@marktiderman/genesis-ui-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/DESIGN-LIBRARY.md"
        }
      ]
    }
  }
}
