{
  "name": "@marktiderman/genesis-extension",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Build Chrome extensions (Manifest V3) with Genesis: checked messaging, settings storage, the UI as a floating panel, a top bar or Chrome's side panel, an in-page bar, native-helper jobs, React pieces built on Genesis UI, and a Chrome fake for tests. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "chrome-extension",
    "manifest-v3",
    "browser-extension"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/extension#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/extension"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui": "workspace:^",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-ui": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "genesis": {
    "doctor": {
      "prefer": [
        {
          "id": "checked-messaging",
          "need": "messages and settings in a Chrome extension",
          "level": "warn",
          "forbid": {
            "pattern": "\\bchrome\\s*\\.\\s*(?:runtime\\s*\\.\\s*(?:sendMessage|onMessage)|storage\\s*\\.\\s*(?:local|sync|session))\\b"
          },
          "use": "request / createRouter for messages and createPrefs for settings",
          "import": "@marktiderman/genesis-extension",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/extension/README.md",
          "why": "Checked messages and settings are typed and testable with the Chrome fake; raw chrome.* calls are neither."
        }
      ]
    }
  }
}
