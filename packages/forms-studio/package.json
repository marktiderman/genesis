{
  "name": "@marktiderman/genesis-forms-studio",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "The form workspace around a Genesis Forms builder: the page header, the Responses tab (filters, headline numbers, question summaries, a follow-up list), the Settings page layout and the Share dialog, plus the pure summary, answer, share and availability rules behind them. Data-agnostic: the host passes rows and actions. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/forms-studio"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css && node ../../scripts/check-exports-resolve.mjs && tsc -p type-tests",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.0.0"
  },
  "peerDependencies": {
    "@marktiderman/genesis-core": "workspace:>=1.12.0 <3.0.0",
    "@marktiderman/genesis-forms": "workspace:>=0.6.0 <1.0.0",
    "@marktiderman/genesis-ui": "workspace:>=2.14.0 <3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-forms": "workspace:^",
    "@marktiderman/genesis-ui": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "genesis": {
    "doctor": {
      "enforce": false,
      "reason": "Its components are already checked by the built-in local-genesis-copy and page-layout rules (componentPackages).",
      "primitives": [
        {
          "need": "a form's workspace: responses, settings, share",
          "use": "ResponsesFilters, QuestionSummaryCards and the settings and share parts",
          "import": "@marktiderman/genesis-forms-studio",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/forms-studio/README.md"
        }
      ]
    }
  }
}
