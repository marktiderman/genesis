{
  "name": "@marktiderman/genesis-studio-server",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "deprecated": "Renamed to @marktiderman/genesis-data-server (Genesis Data Studio is now Genesis Data): change the imports and the dependency to the new name; the exports and the `genesis-studio-server` command are the same. This alias re-exports genesis-data-server for two minor versions, then goes.",
  "description": "Deprecated: renamed to @marktiderman/genesis-data-server. A thin re-export of genesis-data-server with the same entries and command, kept for two minor versions. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "deprecated"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/studio-server#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/studio-server"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "auth": [
        "./dist/auth.d.cts"
      ]
    }
  },
  "bin": {
    "genesis-studio-server": "./dist/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-data-server": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "primitive",
    "group": "data",
    "owner": "@marktiderman",
    "doctor": {
      "enforce": false,
      "reason": "A deprecated alias that re-exports @marktiderman/genesis-data-server, whose declarations carry the rules."
    }
  },
  "peerDependencies": {
    "@marktiderman/genesis-core": "^1.11.0 || ^2.0.0"
  }
}
