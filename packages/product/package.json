{
  "name": "@marktiderman/genesis-product",
  "version": "0.0.7",
  "type": "module",
  "sideEffects": false,
  "description": "The product system for a Genesis repo: a Now / Next / Later board from features.ts with demand from ideas and feedback, a triage inbox, and release notes that close the loop with the people who asked. Ideas and feedback come from GitHub issues today, behind a SignalSource contract. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "roadmap",
    "product-management",
    "changelog"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/product#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/product"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "genesis-product": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./src/native/index.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-features": "workspace:^"
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui-native": "workspace:>=2.9.0 <4.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui-native": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-notifications": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "genesis": {
    "doctor": {
      "enforce": false,
      "reason": "Repository tooling (the product board, triage and release notes), not app screens."
    }
  }
}
