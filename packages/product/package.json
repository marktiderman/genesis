{
  "name": "@marktiderman/genesis-product",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "The product system for a Genesis repo: a Now / Next / Later board from features.ts with demand from ideas and feedback, a triage inbox, and release notes that close the loop with the people who asked. Ideas and feedback come from GitHub issues today, behind a SignalSource contract. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "roadmap",
    "product-management",
    "changelog"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/product#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/product"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "bin": {
    "genesis-product": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./src/native/index.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marktiderman/genesis-features": "workspace:^"
  },
  "peerDependencies": {
    "@marktiderman/genesis-ui-native": "workspace:>=2.9.0 <4.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@marktiderman/genesis-ui-native": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-notifications": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "module",
    "group": "modules",
    "owner": "@marktiderman",
    "module": {
      "name": "Product",
      "summary": "A Now / Next / Later roadmap, an idea board with votes and what's new, for the app's own people.",
      "blocks": [
        "product-board"
      ],
      "install": "genesis add product-board",
      "docs": "README.md",
      "skill": "SKILL.md"
    },
    "toolingEntries": [
      "./node"
    ],
    "doctor": {
      "enforce": false,
      "reason": "The board, idea board and release notes are screens and data an app adds whole; the repo CLI (bin genesis-product, ./node) is tooling."
    },
    "blocks": {
      "product-board": {
        "feature": {
          "name": "Product board",
          "summary": "A Now / Next / Later roadmap from features.ts, an idea board with votes, and what's new, on the phone for the app's own people.",
          "keywords": [
            "roadmap",
            "idea board",
            "votes",
            "what's new",
            "release notes"
          ],
          "audience": [
            "person"
          ]
        },
        "platforms": [
          "native",
          "server"
        ],
        "steps": [
          "Give the screens a ProductSource (ideas, votes, roadmap, what's new); there is no database source yet (genesis-product README, Native screens).",
          "Render IdeaBoardScreen and RoadmapScreen from @marktiderman/genesis-product/native on routes of your own, with a vote queue made once by createVoteQueue.",
          "To tell people when their idea shipped, spread productNotifications from @marktiderman/genesis-product/server into your genesis-notifications registry and run syncNotificationTypes on deploy."
        ]
      }
    }
  }
}
