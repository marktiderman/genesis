{
  "name": "@marktiderman/genesis-design-system",
  "version": "1.5.1",
  "private": false,
  "type": "module",
  "description": "Genesis brand-agnostic design tokens, canonical brand schema (with extensions slot), brand-genesis OOTB fallback, and theme generation. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "design-tokens",
    "design-system",
    "tailwind",
    "dtcg",
    "theming"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/design-system",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/design-system"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:tokens:native && tsup && pnpm build:tokens:css",
    "build:tokens": "tsx style-dictionary.config.ts",
    "build:tokens:native": "tsx style-dictionary.config.ts native",
    "build:tokens:css": "tsx style-dictionary.config.ts css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens/native": {
      "types": "./dist/tokens/native.d.ts",
      "import": "./dist/tokens/native.js"
    },
    "./providers/native": {
      "types": "./dist/providers/native.d.ts",
      "import": "./dist/providers/native.js",
      "default": "./dist/providers/native.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js",
      "default": "./dist/presets/*.js"
    },
    "./schema/brand": {
      "types": "./dist/schema/brand.d.ts",
      "import": "./dist/schema/brand.js"
    },
    "./schema/brand.schema.json": "./schema/brand.schema.json",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.native.js",
      "import": "./dist/theme/index.js"
    },
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "ajv": "^8.17.0",
    "happy-dom": "^21.0.4",
    "style-dictionary": "5",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "foundation",
    "group": "core",
    "essential": true,
    "doctor": {
      "enforce": false,
      "reason": "Its rules are built in to the doctor: raw-color, palette-color, arbitrary-color and undefined-token read its tokens.",
      "primitives": [
        {
          "need": "a brand's colors and fonts",
          "use": "a brand file (the brand schema) and tailwindFromBrand",
          "import": "@marktiderman/genesis-design-system",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/design-system/README.md"
        }
      ]
    }
  }
}
