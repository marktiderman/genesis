{
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, ui-sans-serif, system-ui, sans-serif" },
      "display": { "$type": "fontFamily", "$value": "Space Grotesk, ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, SF Mono, Menlo, monospace" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" }
    },
    "lineHeight": {
      "xs": { "$type": "dimension", "$value": "16px" },
      "sm": { "$type": "dimension", "$value": "20px" },
      "base": { "$type": "dimension", "$value": "24px" },
      "lg": { "$type": "dimension", "$value": "28px" },
      "xl": { "$type": "dimension", "$value": "28px" },
      "2xl": { "$type": "dimension", "$value": "32px" },
      "3xl": { "$type": "dimension", "$value": "36px" }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "presets": {
      "h1": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.3xl}",
          "lineHeight": "{font.lineHeight.3xl}",
          "fontWeight": "{font.weight.bold}"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.2xl}",
          "lineHeight": "{font.lineHeight.2xl}",
          "fontWeight": "{font.weight.bold}"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.xl}",
          "lineHeight": "{font.lineHeight.xl}",
          "fontWeight": "{font.weight.semibold}"
        }
      },
      "h4": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.lg}",
          "lineHeight": "{font.lineHeight.lg}",
          "fontWeight": "{font.weight.semibold}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.base}",
          "lineHeight": "{font.lineHeight.base}",
          "fontWeight": "{font.weight.normal}"
        }
      },
      "body-sm": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.sm}",
          "lineHeight": "{font.lineHeight.sm}",
          "fontWeight": "{font.weight.normal}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontSize": "{font.size.xs}",
          "lineHeight": "{font.lineHeight.xs}",
          "fontWeight": "{font.weight.normal}"
        }
      }
    }
  }
}
