{
  "name": "@marktiderman/genesis-native",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "The native app shell for Genesis Expo apps: one GenesisNativeApp root that runs boot steps behind the splash, catches errors into a fatal screen with retry, persists the query cache, gates on the Supabase session and normalizes deep links. Every part is a slot and is also exported on its own. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/query-async-storage-persister": "^5.0.0",
    "@tanstack/query-persist-client-core": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/query-persist-client-core": "5.101.4",
    "@tanstack/react-query": "^5.75.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
