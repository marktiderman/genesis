{
  "name": "@marktiderman/genesis-native",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "The native app shell for Genesis Expo apps: one GenesisNativeApp root that runs boot steps behind the splash, catches errors into a fatal screen with retry, persists the query cache, gates on the Supabase session and normalizes deep links. An optional updates block (/updates) adds force upgrade, maintenance, an update banner and what's new; an optional push block (/push) adds push registration, tap routing, the badge and a notification settings screen with quiet hours and private previews; the observability block (/observability) reports errors, breadcrumbs, typed analytics events and timings through vendor-neutral sinks (Sentry, EAS Observe, console) with PII scrubbed on the device; the devtools overlay (/devtools) is a debug sheet for development and preview builds. Blocks (defineBlock declarations, through `blocks`) add boot steps, roots, slot fills and Settings rows. Every part is a slot and is also exported on its own. Part of the Genesis framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "react-native": "./src/persist.ts",
      "import": "./dist/persist.js"
    },
    "./updates": {
      "types": "./dist/updates.d.ts",
      "react-native": "./src/updates/index.ts",
      "import": "./dist/updates.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "react-native": "./src/push/index.ts",
      "import": "./dist/push.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "react-native": "./src/observability/index.ts",
      "import": "./dist/observability.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "react-native": "./src/devtools/index.ts",
      "import": "./dist/devtools.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-features": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/query-async-storage-persister": "^5.0.0",
    "@tanstack/query-persist-client-core": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react-native": {
      "optional": true
    },
    "@tanstack/query-async-storage-persister": {
      "optional": true
    },
    "@tanstack/query-persist-client-core": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-observe": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/query-persist-client-core": "5.101.4",
    "@tanstack/react-query": "^5.75.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
