{
  "name": "@marktiderman/genesis-native",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "The native app shell for Genesis Expo apps: one GenesisNativeApp root that runs boot steps behind the splash, catches errors into a fatal screen with retry, persists the query cache, gates on the Supabase session and normalizes deep links. An optional updates block (/updates) adds force upgrade, maintenance, an update banner and what's new; an optional push block (/push) adds push registration, tap routing, the badge and a notification settings screen with quiet hours and private previews; the observability block (/observability) reports errors, breadcrumbs, typed analytics events and timings through vendor-neutral sinks (Sentry, EAS Observe, console) with PII scrubbed on the device; the devtools overlay (/devtools) is a debug sheet for development and preview builds. openOnWeb (/web-handoff) opens a page of the web app signed in as the same person. Blocks (defineBlock declarations, through `blocks`) add boot steps, roots, slot fills and Settings rows. Every part is a slot and is also exported on its own. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "react-native",
    "expo",
    "app-shell",
    "notifications",
    "push-token",
    "quiet-hours",
    "force-upgrade",
    "maintenance",
    "ota",
    "crash-reporting",
    "sentry",
    "analytics",
    "breadcrumbs"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/native#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "react-native": "./src/persist.ts",
      "import": "./dist/persist.js"
    },
    "./updates": {
      "types": "./dist/updates.d.ts",
      "react-native": "./src/updates/index.ts",
      "import": "./dist/updates.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "react-native": "./src/push/index.ts",
      "import": "./dist/push.js"
    },
    "./push-payload": {
      "types": "./dist/push-payload.d.ts",
      "import": "./dist/push-payload.js",
      "default": "./dist/push-payload.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "react-native": "./src/observability/index.ts",
      "import": "./dist/observability.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "react-native": "./src/devtools/index.ts",
      "import": "./dist/devtools.js"
    },
    "./web-handoff": {
      "types": "./dist/web-handoff.d.ts",
      "react-native": "./src/web-handoff.ts",
      "import": "./dist/web-handoff.js"
    },
    "./dev-warnings": {
      "types": "./dist/dev-warnings.d.ts",
      "react-native": "./src/dev-warnings.ts",
      "import": "./dist/dev-warnings.js"
    },
    "./rich-push-plugin": {
      "types": "./dist/rich-push-plugin.d.ts",
      "import": "./dist/rich-push-plugin.js",
      "default": "./dist/rich-push-plugin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ios",
    "!src/**/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-features": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^"
  },
  "peerDependencies": {
    "@marktiderman/genesis-core": "workspace:>=2.1.0 <3.0.0",
    "nativewind": "^4.0.0 || ^5.0.0-preview",
    "@tanstack/query-async-storage-persister": "^5.0.0",
    "@tanstack/query-persist-client-core": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": ">=54",
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react-native": {
      "optional": true
    },
    "@tanstack/query-async-storage-persister": {
      "optional": true
    },
    "@tanstack/query-persist-client-core": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "expo-observe": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/query-persist-client-core": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "expo": "~58.0.19",
    "happy-dom": "^21.0.4",
    "nativewind": "^4.2.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "layer": "primitive",
    "group": "shells",
    "owner": "@marktiderman",
    "blocks": {
      "push": {
        "feature": {
          "name": "Push and notification preferences",
          "summary": "Registers this device's push token for whoever signs in, routes taps, and edits per-category preferences, quiet hours and previews.",
          "keywords": [
            "notifications",
            "push token",
            "quiet hours"
          ],
          "audience": [
            "person"
          ]
        },
        "platforms": [
          "native"
        ],
        "packages": [
          "@marktiderman/genesis-native",
          "@marktiderman/genesis-supabase"
        ],
        "migrations": [
          {
            "package": "@marktiderman/genesis-supabase",
            "file": "migrations/0005_genesis_push.sql",
            "test": "migrations/tests/0005_genesis_push.test.sql"
          }
        ],
        "functions": [
          {
            "package": "@marktiderman/genesis-supabase",
            "dir": "functions/genesis-push-send",
            "verifyJwt": false,
            "secrets": [
              "GENESIS_PUSH_SECRET",
              "EXPO_ACCESS_TOKEN"
            ]
          }
        ],
        "routes": [
          {
            "path": "/settings/notifications",
            "description": "Notification settings: categories, quiet hours, previews",
            "signedIn": true
          }
        ],
        "steps": [
          "npx expo install expo-notifications, and add \"expo-notifications\" to the plugins in app.config.",
          "Create the block with createPush (@marktiderman/genesis-native/push) and pass it to <GenesisNativeApp blocks>; render NotificationSettings on the /settings/notifications screen (genesis-native README, Push).",
          "A push token needs an EAS project id (eas init)."
        ],
        "privacy": {
          "collects": [
            {
              "type": "device ID",
              "purposes": [
                "app functionality"
              ],
              "linked": true,
              "tracking": false
            }
          ]
        }
      },
      "app-updates": {
        "feature": {
          "name": "App updates",
          "summary": "Force upgrade, a maintenance screen, an update banner and a what's new sheet, from the app_release_policy row.",
          "keywords": [
            "force upgrade",
            "maintenance",
            "ota"
          ],
          "audience": [
            "person"
          ]
        },
        "platforms": [
          "native"
        ],
        "packages": [
          "@marktiderman/genesis-native",
          "@marktiderman/genesis-supabase"
        ],
        "migrations": [
          {
            "package": "@marktiderman/genesis-supabase",
            "file": "migrations/0002_genesis_app_release_policy.sql",
            "test": "migrations/tests/0002_genesis_app_release_policy.test.sql"
          }
        ],
        "steps": [
          "npx expo install expo-updates expo-application.",
          "Create the block with createUpdates (@marktiderman/genesis-native/updates) and pass it to <GenesisNativeApp updates> (genesis-native README, Updates)."
        ]
      },
      "observability": {
        "feature": {
          "name": "Observability",
          "summary": "Crash reports, breadcrumbs, timings and typed analytics events, scrubbed on the device, through vendor-neutral sinks (Sentry included).",
          "keywords": [
            "crash reporting",
            "sentry",
            "analytics",
            "breadcrumbs"
          ],
          "audience": [
            "developer"
          ]
        },
        "platforms": [
          "native"
        ],
        "steps": [
          "npx expo install @sentry/react-native if you report to Sentry, and set the DSN in your environment (genesis-native README, Observability).",
          "Create the block with createObservability (@marktiderman/genesis-native/observability) at module scope, pass it to <GenesisNativeApp blocks>, and export observability.wrap(RootLayout)."
        ],
        "privacy": {
          "collects": [
            {
              "type": "crash data",
              "purposes": [
                "app functionality"
              ],
              "linked": true,
              "tracking": false
            },
            {
              "type": "performance data",
              "purposes": [
                "app functionality"
              ],
              "linked": true,
              "tracking": false
            },
            {
              "type": "other diagnostic data",
              "purposes": [
                "app functionality"
              ],
              "linked": true,
              "tracking": false
            },
            {
              "type": "user id",
              "purposes": [
                "app functionality"
              ],
              "linked": true,
              "tracking": false
            }
          ]
        }
      },
      "devtools-overlay": {
        "feature": {
          "name": "Devtools overlay",
          "summary": "An on-device overlay for development, preview and internal builds: what the app knows about itself, recent activity, a crash test.",
          "keywords": [
            "debug menu",
            "devtools",
            "shake to debug"
          ],
          "audience": [
            "developer"
          ]
        },
        "platforms": [
          "native"
        ],
        "steps": [
          "Create the block with createDevtools (@marktiderman/genesis-native/devtools), enabled only outside production builds, and pass it to <GenesisNativeApp blocks> (genesis-native README)."
        ]
      }
    },
    "doctor": {
      "prefer": [
        {
          "id": "app-root",
          "need": "the phone app's root: splash, boot, cache, session",
          "level": "warn",
          "platform": "native",
          "forbid": {
            "imports": [
              "expo-splash-screen",
              "@tanstack/query-async-storage-persister",
              "@tanstack/react-query-persist-client"
            ]
          },
          "unless": {
            "renders": [
              "GenesisNativeApp"
            ]
          },
          "use": "<GenesisNativeApp> (boot steps behind the splash, the persisted query cache, the session gate)",
          "import": "@marktiderman/genesis-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/packages/native/README.md",
          "why": "The boot, the fatal screen with retry, the cache and the session gate are one root; rebuilding them by hand loses the error handling."
        }
      ]
    }
  }
}
