{
  "name": "@marktiderman/genesis-forms-native",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "The React Native renderer for Genesis Forms: <FormFocus>, one question or content step per screen, with keyboard-aware scrolling, accessibility focus and announcements, Dynamic Type, reduced motion, a theme seam for system or Genesis colors, and seams for drafts, an offline outbox and photo uploads. The same definitions run on web, native and the server. Part of the Genesis framework.",
  "keywords": [
    "genesis",
    "genesis-framework",
    "forms",
    "react-native",
    "expo",
    "survey",
    "check-in",
    "onboarding"
  ],
  "homepage": "https://github.com/marktiderman/genesis/tree/main/packages/forms-native#readme",
  "bugs": {
    "url": "https://github.com/marktiderman/genesis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktiderman/genesis.git",
    "directory": "packages/forms-native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/check-exports-resolve.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@marktiderman/genesis-core": "workspace:>=1.17.0 <3.0.0",
    "@marktiderman/genesis-forms": "workspace:>=0.7.0 <1.0.0",
    "@marktiderman/genesis-forms-react": "workspace:>=0.3.0 <1.0.0",
    "@marktiderman/genesis-ui-native": "workspace:>=2.9.0 <4.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@marktiderman/genesis-core": "workspace:^",
    "@marktiderman/genesis-design-system": "workspace:^",
    "@marktiderman/genesis-forms": "workspace:^",
    "@marktiderman/genesis-forms-react": "workspace:^",
    "@marktiderman/genesis-ui-native": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "0.88.0",
    "tsup": "^8.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "genesis": {
    "doctor": {
      "enforce": false,
      "reason": "A renderer for Genesis Forms; the rule that forms go through Genesis Forms is genesis-forms-react's.",
      "primitives": [
        {
          "need": "a form on the phone",
          "use": "<FormFocus> (one step per screen)",
          "import": "@marktiderman/genesis-forms-native",
          "docs": "https://github.com/marktiderman/genesis/blob/main/docs/FORMS.md"
        }
      ]
    }
  }
}
